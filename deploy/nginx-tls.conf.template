# The only internet-facing proxy in the bundled deployment. Never trust client
# supplied forwarding headers; an additional upstream proxy needs an explicit
# set_real_ip_from allowlist before $remote_addr may represent its client.
limit_req_zone $binary_remote_addr zone=jf_login:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=jf_api:10m rate=20r/s;
# Limit costly POST creation separately; GET polling/listing keeps the API limit.
map $request_method $jf_write_source { default ""; POST $binary_remote_addr; }
limit_req_zone $jf_write_source zone=jf_upload:1m rate=6r/m;
limit_req_zone $jf_write_source zone=jf_export:1m rate=6r/m;
limit_req_zone $jf_write_source zone=jf_ai:1m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=jf_connections:10m;
# Do not log query strings (may contain bearer/presigned credentials).
log_format jf_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent request_id=$request_id upstream_request_id=$upstream_http_x_request_id';
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name ${JIAFENG_PUBLIC_HOST};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:jf_tls:10m;
  ssl_session_timeout 10m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  root /usr/share/nginx/html;
  client_max_body_size 52m;
  client_body_timeout 20s;
  client_header_timeout 10s;
  keepalive_timeout 30s;
  send_timeout 30s;
  limit_conn jf_connections 30;
  limit_req_status 429;
  server_tokens off;
  access_log /var/log/nginx/access.log jf_safe;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(), geolocation=()" always;

  location ~ "^/api/v1/auth/login(?:;[^/]*)?/?$" {
    # Request errors otherwise log full query strings; safe access status and
    # upstream request IDs retain failure visibility without signed/token URLs.
    error_log /dev/null crit;
    limit_req zone=jf_login burst=10 nodelay;
    proxy_pass http://server:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location ~ "^/api/v1/files(?:;[^/]*)?/?$" {
    # Request errors otherwise log full query strings; safe access status and
    # upstream request IDs retain failure visibility without signed/token URLs.
    error_log /dev/null crit;
    limit_req zone=jf_api burst=60 nodelay;
    limit_req zone=jf_upload burst=3 nodelay;
    proxy_pass http://server:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location ~ "^/api/v1/admin/exports(?:;[^/]*)?/?$" {
    # Request errors otherwise log full query strings; safe access status and
    # upstream request IDs retain failure visibility without signed/token URLs.
    error_log /dev/null crit;
    limit_req zone=jf_api burst=60 nodelay;
    limit_req zone=jf_export burst=3 nodelay;
    proxy_pass http://server:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location ~ "^/api/v1/ai/tasks(?:;[^/]*)?/?$" {
    # Request errors otherwise log full query strings; safe access status and
    # upstream request IDs retain failure visibility without signed/token URLs.
    error_log /dev/null crit;
    limit_req zone=jf_api burst=60 nodelay;
    limit_req zone=jf_ai burst=5 nodelay;
    proxy_pass http://server:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location /api/v1/ {
    # Request errors otherwise log full query strings; safe access status and
    # upstream request IDs retain failure visibility without signed/token URLs.
    error_log /dev/null crit;
    limit_req zone=jf_api burst=60 nodelay;
    proxy_pass http://server:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }
  # The independent product uses only /api/v1. Retained upstream admin
  # controllers have separate identity assumptions and are not public entries.
  location ~ ^/(auth|system|resource|workflow|warm-flow)(/|$) {
    return 404;
  }
  # Only signed object GET/HEAD requests are exposed, with the original host
  # and unmodified bucket/key path used by AWS SigV4. Writes use the business API.
  location ^~ /jiafeng-private/ {
    limit_except GET HEAD { deny all; }
    proxy_pass http://storage:8333;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "sandbox" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Nginx error logs may include request query strings; signing parameters
    # must not be persisted. Connection failures remain visible in access status.
    error_log /dev/null crit;
  }
  location = /healthz { access_log off; return 200 'ok'; add_header Content-Type text/plain; }
  location = /admin { return 308 /admin/; }
  location /admin/ { try_files $uri $uri/ /admin/index.html; }
  location / { try_files $uri $uri/ /index.html; }
}

# HTTP remains internal for the existing liveness probe; no HTTP host port is
# published by compose.https.yaml. Use HTTPS directly for public clients.
server {
  listen 80;
  server_name _;
  location = /healthz { access_log off; return 200 'ok'; }
  location / { return 301 https://${JIAFENG_PUBLIC_HOST}$request_uri; }
}
