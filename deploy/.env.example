# ./deploy/dev up generates deploy/.env with random secrets on first use.
COMPOSE_PROJECT_NAME=jiafeng-dev
JIAFENG_BIND_ADDRESS=127.0.0.1
JIAFENG_HTTP_PORT=18080
JIAFENG_S3_PORT=18333
JIAFENG_S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
JIAFENG_DEV_ACCOUNTS_ENABLED=true
JIAFENG_PUBLIC_CACHE_ENABLED=true
# DB_PASSWORD, MYSQL_ROOT_PASSWORD, REDIS_PASSWORD, JIAFENG_TOKEN_SECRET,
# JIAFENG_HEALTH_PASSWORD, JIAFENG_DEV_PASSWORD, JIAFENG_S3_ACCESS_KEY and
# JIAFENG_S3_SECRET_KEY are generated; never commit real credentials.
