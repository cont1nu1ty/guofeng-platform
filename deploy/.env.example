# ./deploy/dev up generates deploy/.env with random secrets on first use.
COMPOSE_PROJECT_NAME=jiafeng-dev
JIAFENG_BIND_ADDRESS=127.0.0.1
# Optional second bind; IPv4 remains active. Use :: for IPv6 LAN/public access.
JIAFENG_IPV6_ENABLED=false
JIAFENG_IPV6_BIND_ADDRESS=::1
JIAFENG_HTTP_PORT=18080
JIAFENG_S3_PORT=18333
JIAFENG_S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
# Set to http://[your-global-ipv6-address]:18333 when enabling external IPv6.
JIAFENG_S3_PUBLIC_IPV6_ENDPOINT=
# Optional standalone HTTPS: see deploy/README.md. IPv6 overlay must be disabled;
# HTTPS overlay publishes both families and stops the direct S3 port publication.
JIAFENG_HTTPS_ENABLED=false
# JIAFENG_PUBLIC_HOST=your-certificate-domain.example
# JIAFENG_TLS_CERT_FILE=/etc/jiafeng/tls/fullchain.pem
# JIAFENG_TLS_KEY_FILE=/etc/jiafeng/tls/privkey.pem
# JIAFENG_TLS_BIND_ADDRESS=0.0.0.0
# JIAFENG_TLS_IPV6_BIND_ADDRESS=::
# JIAFENG_HTTPS_PORT=443
# JIAFENG_S3_PUBLIC_ENDPOINT=https://your-certificate-domain.example
JIAFENG_DEV_ACCOUNTS_ENABLED=true
JIAFENG_PUBLIC_CACHE_ENABLED=true
# DB_PASSWORD, MYSQL_ROOT_PASSWORD, REDIS_PASSWORD, JIAFENG_TOKEN_SECRET,
# JIAFENG_HEALTH_PASSWORD, JIAFENG_DEV_PASSWORD, JIAFENG_S3_ACCESS_KEY and
# JIAFENG_S3_SECRET_KEY are generated; never commit real credentials.

# AI stays disabled on a clean installation until explicitly configured.
# JIAFENG_AI_SERVICE_KEY is generated by deploy/dev and is internal only.
JIAFENG_AI_ENABLED=false
JIAFENG_AI_PROVIDER=openai-compatible
JIAFENG_AI_EXTERNAL=false
# Local OpenAI-compatible example; inside containers localhost means that container.
JIAFENG_AI_BASE_URL=http://host.docker.internal:8000/v1
JIAFENG_AI_MODEL=
JIAFENG_AI_API_KEY=
# Development Zhipu example: provider=zhipu, external=true,
# base URL=https://open.bigmodel.cn/api/paas/v4, model=glm-5.2.
# OCR can use a different local endpoint/key. Empty overrides inherit the text endpoint/key.
JIAFENG_AI_OCR_MODEL=
# Optional separate OCR provider; blank values inherit text URL/key in Compose.
JIAFENG_AI_OCR_BASE_URL=
JIAFENG_AI_OCR_API_KEY=
JIAFENG_AI_OCR_PROTOCOL=layout
JIAFENG_AI_TIMEOUT_SECONDS=110
