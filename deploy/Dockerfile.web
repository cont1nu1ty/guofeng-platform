# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /workspace
COPY apps/admin/package*.json apps/admin/
COPY apps/miniapp/package*.json apps/miniapp/
RUN cd apps/admin && npm ci --no-audit && cd ../miniapp && npm ci --no-audit
COPY apps/admin/ apps/admin/
COPY apps/miniapp/ apps/miniapp/
ENV VITE_DATA_MODE=http VITE_API_BASE_URL=/api/v1
RUN cd apps/admin && npm run build -- --base=/admin/
RUN cd apps/miniapp && npm run build:h5

FROM nginx:1.29.6-alpine@sha256:f46cb72c7df02710e693e863a983ac42f6a9579058a59a35f1ae36c9958e4ce0
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/admin/dist/ /usr/share/nginx/html/admin/
COPY --from=build /workspace/apps/miniapp/dist/build/h5/ /usr/share/nginx/html/
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/jiafeng/THIRD_PARTY_NOTICES.md
COPY licenses/ /usr/share/licenses/jiafeng/components/
EXPOSE 80
