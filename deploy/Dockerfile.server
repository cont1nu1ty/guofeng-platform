# syntax=docker/dockerfile:1
FROM maven:3.9.11-eclipse-temurin-21@sha256:6fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d237 AS build
WORKDIR /build
COPY apps/server/ ./
RUN --mount=type=cache,target=/root/.m2 mvn -B -ntp -pl ruoyi-admin -am package -Dmaven.test.skip=true

FROM eclipse-temurin:21-jre-alpine@sha256:51ab5e3302e7141ce665ca3ea85e8b5cd648eafbc3c0c90dd79d6537684e4555
RUN addgroup -S jiafeng && adduser -S -G jiafeng jiafeng
WORKDIR /app
RUN mkdir -p logs && chown -R jiafeng:jiafeng /app
COPY --from=build --chown=jiafeng:jiafeng /build/ruoyi-admin/target/ruoyi-admin.jar /app/app.jar
COPY apps/server/LICENSE /usr/share/licenses/jiafeng/RuoYi-Vue-Plus.MIT.txt
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/jiafeng/THIRD_PARTY_NOTICES.md
COPY licenses/ /usr/share/licenses/jiafeng/components/
USER jiafeng
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/app.jar", "--spring.profiles.active=compose"]
