{
  "name": "@jiafeng/miniapp",
  "version": "0.5.1",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "uni --host 0.0.0.0 --port 5173",
    "dev:h5": "uni --host 0.0.0.0 --port 5173",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "uni build",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin && node ../../scripts/check-mp-package.cjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080520251106001",
    "@dcloudio/uni-components": "3.0.0-4080520251106001",
    "@dcloudio/uni-h5": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080520251106001",
    "@wot-ui/ui": "2.3.1",
    "vue": "3.4.38"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.19",
    "@dcloudio/uni-cli-shared": "3.0.0-4080520251106001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080520251106001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080520251106001",
    "@types/node": "20.16.2",
    "@uni-helper/plugin-uni": "0.1.0",
    "@vue/tsconfig": "0.5.1",
    "prettier": "3.5.3",
    "sass": "1.99.0",
    "typescript": "5.5.4",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue-tsc": "2.0.29"
  }
}
